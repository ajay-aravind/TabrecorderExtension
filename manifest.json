
{
  "manifest_version": 3,
  "name": "Tab Recorder",
  "version": "1.0",
  "description": "Record browser tab video and audio",
  "permissions": [
    "tabCapture",
    "tabs",
    "offscreen",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Recorder"
  }
}
